{
  "_comment": "Copy to olympus.providers.json (git-ignored) and edit. Keys never go in this file: api_key_env names an environment variable, or a line in .env. Model ids in <angle brackets> are placeholders you must replace; check each provider's model list. A cli command is an argv list (no shell); the brief goes on stdin and stdout is the answer; {model} in an argument is replaced by the target's model.",
  "targets": {
    "claude-opus": {
      "adapter": "anthropic",
      "model": "claude-opus-5-5",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "claude-sonnet": {
      "adapter": "anthropic",
      "model": "claude-sonnet-5-5",
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "openai-<placeholder>": {
      "adapter": "openai",
      "provider": "openai",
      "model": "<openai model id>",
      "api_key_env": "OPENAI_API_KEY"
    },
    "kimi": {
      "adapter": "openai",
      "provider": "moonshot",
      "model": "<moonshot model id>",
      "api_key_env": "MOONSHOT_API_KEY"
    },
    "openrouter-<example>": {
      "adapter": "openai",
      "provider": "openrouter",
      "model": "<vendor/model-id as listed on openrouter.ai>",
      "api_key_env": "OPENROUTER_API_KEY"
    },
    "ollama-local": {
      "adapter": "openai",
      "provider": "ollama",
      "model": "<model you pulled with ollama pull>",
      "base_url": "http://localhost:11434/v1"
    },
    "codex-cli": {
      "adapter": "cli",
      "model": "<codex model id>",
      "command": ["codex", "exec", "--model", "{model}", "--sandbox", "read-only", "--skip-git-repo-check", "--ephemeral", "-"]
    },
    "claude-cli": {
      "adapter": "cli",
      "model": "claude-opus-5-5",
      "command": ["claude", "-p", "--model", "{model}"]
    }
  }
}
