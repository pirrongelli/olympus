# Optional. Olympus works without any of these.
# Copy to .env (git-ignored) and fill in only if you want the optional Jev steps.

# TypeSafe API key for Jev (https://docs.typesafe.ai). Read by tools/olympus_call.py (the typesafe
# adapter), not by an SDK; nothing else is needed. Used only by the optional J1 meta-check.
TYPESAFE_API_KEY=

# Optional: API keys for running panel seats, Arena judges or reviewers on other
# providers through tools/olympus_call.py. Leave unset to use only native subagents.
# Anthropic API key (adapter "anthropic").
ANTHROPIC_API_KEY=
# OpenAI API key (adapter "openai", provider "openai").
OPENAI_API_KEY=
# Moonshot (Kimi) API key (adapter "openai", provider "moonshot").
MOONSHOT_API_KEY=
# OpenRouter API key (adapter "openai", provider "openrouter").
OPENROUTER_API_KEY=
